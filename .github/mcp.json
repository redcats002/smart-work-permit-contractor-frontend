{
	"mcpServers": {
		"primevue": {
			"command": "npx",
			"args": ["-y", "@primevue/mcp"],
			"tools": ["*"]
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"tools": ["*"]
		},
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp",
			"tools": ["*"]
		},
		"rtk": {
			"command": "rtk-mcp",
			"args": [],
			"tools": ["*"]
		},
		"playwright": {
			"command": "npx",
			"args": ["@playwright/mcp@latest"],
			"tools": ["*"]
		},
		"memory": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-memory"],
			"tools": ["*"]
		}
	}
}
