# Backend base URL — the app appends /api/v1 itself via each provider's urlPrefix.
VITE_APP_API_URL=http://localhost:3000
VITE_APP_WEBSOCKET=

# Auth is a better-auth session cookie, so requests go out with credentials. The API must answer
# with this app's exact origin in CORS_ORIGIN — a wildcard silently disables credentialed CORS and
# login will not stick. See docs/main/dev-handoff/04-api-contract.md §2.

# Trial auto-login button on the login page. Calls the server-issued demo login route
# (POST /api/v1/auth/demo-login, wayfinder ticket 023) with role "contractor" — the server signs
# in a dedicated demo account and returns a session, so this client never holds or sends a
# password. There is no password env var: a Vite env var is a build-time substitution, not a
# secret, so a password here would ship inside the bundle of any build with the flag on. Defaults
# OFF; the button is hidden unless VITE_TRIAL_LOGIN is exactly 'true'. The endpoint itself is off
# unless the deployment sets DEMO_LOGIN_ENABLED=TRUE server-side — a build with this flag on
# against a deployment without that flag gets a localized "not available" message and the button
# hides itself.
VITE_TRIAL_LOGIN=false
