# Backend base URL — the app appends /api/v1 itself via each provider's urlPrefix.
VITE_APP_API_URL=http://localhost:3000
VITE_APP_WEBSOCKET=

# Auth is a better-auth session cookie, so requests go out with credentials. The API must answer
# with this app's exact origin in CORS_ORIGIN — a wildcard silently disables credentialed CORS and
# login will not stick. See docs/main/dev-handoff/04-api-contract.md §2.

# There is deliberately NO trial/demo login variable here. wayfinder ticket 042 (owner ruling
# 2026-09-08) deleted the server-issued demo login and the UAT form-fill button along with their
# shared VITE_TRIAL_LOGIN guard: no demo environment will exist, and a flag that is off by default
# is still a route in the bundle and a password in a runbook. Do not reintroduce either.
