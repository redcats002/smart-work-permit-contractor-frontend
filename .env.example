# Backend base URL — the app appends /api/v1 itself via each provider's urlPrefix.
VITE_APP_API_URL=http://localhost:3000
VITE_APP_WEBSOCKET=

# Auth is a better-auth session cookie, so requests go out with credentials. The API must answer
# with this app's exact origin in CORS_ORIGIN — a wildcard silently disables credentialed CORS and
# login will not stick. See docs/main/dev-handoff/04-api-contract.md §2.

# Trial/UAT affordances on the login page. Both gated behind the SAME flag, default OFF:
#
# 1. The trial auto-login button calls the server-issued demo login route
#    (POST /api/v1/auth/demo-login, wayfinder ticket 023) with role "contractor" — the server
#    signs in a dedicated demo account and returns a session, so this client never holds or sends
#    a password. The endpoint itself is off unless the deployment sets DEMO_LOGIN_ENABLED=TRUE
#    server-side — a build with this flag on against a deployment without that flag gets a
#    localized "not available" message and the button hides itself.
# 2. The "fill sign-in form" button (wayfinder ticket 032) fills the visible email/password
#    fields with a fixed test contractor account so a UAT tester can see what they are signing in
#    as. It never submits by itself and never talks to the server.
#
# There is still no credential env var for either: a Vite env var is a build-time substitution,
# not a secret, so a password here would ship inside the bundle of any build with the flag on.
# Both buttons are hidden unless VITE_TRIAL_LOGIN is exactly 'true'. A production build (flag
# unset) must contain neither credential string in dist/ — verified by building with the flag off
# and grepping dist/.
VITE_TRIAL_LOGIN=false
