# Backend base URL — the app appends /api/v1 itself via each provider's urlPrefix.
VITE_APP_API_URL=http://localhost:3000
VITE_APP_WEBSOCKET=

# Auth is a better-auth session cookie, so requests go out with credentials. The API must answer
# with this app's exact origin in CORS_ORIGIN — a wildcard silently disables credentialed CORS and
# login will not stick. See docs/main/dev-handoff/04-api-contract.md §2.

# Trial auto-login button on the login page — DEVELOPMENT / DEMO ONLY, NEVER ENABLE IN PRODUCTION.
# Signs in as the seeded `contractor@e2e.test` account (smart-work-permit-api/prisma/seeds/
# e2e-fixtures.seed.ts — only exists after `bun run seed:e2e`). Defaults OFF; the button is hidden
# unless VITE_TRIAL_LOGIN is exactly 'true' AND a password is set. Never commit a real value for
# either key — leave both blank/placeholder here.
VITE_TRIAL_LOGIN=false
VITE_TRIAL_LOGIN_PASSWORD=
