{
  "name": "smart-work-permit-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "build:alpha": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --watch --reporter=verbose",
    "test:run": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:playwright": "bunx playwright test",
    "test:playwright-ui": "bunx playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@primevue/forms": "^4.5.5",
    "@tailwindcss/vite": "^4.3.2",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "humps": "^2.0.1",
    "js-cookie": "^3.0.8",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primevue": "^4.5.5",
    "qrcode": "^1.5.4",
    "quill": "^2.0.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-primeui": "^0.6.1",
    "thai-address-universal": "^2.1.3",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vue-sanitize-directive": "^0.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@iconify/vue": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/humps": "^2.0.6",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.9.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "dayjs": "^1.11.21",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "unplugin-vue-components": "^31.1.0",
    "vite": "^8.1.3",
    "vite-plugin-eslint2": "^5.3.0",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.6"
  }
}
